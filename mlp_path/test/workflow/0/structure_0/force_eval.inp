
&FORCE_EVAL
  METHOD ${METHOD}
# STRESS_TENSOR ANALYTICAL


  &DFT
    # &POISSON
    #   PERIODIC XY
    #   POISSON_SOLVER MT
    # &END POISSON
    BASIS_SET_FILE_NAME /home/ashiquel/software/cp2k/data/BASIS_SET
    BASIS_SET_FILE_NAME /home/ashiquel/software/cp2k/data/GTH_BASIS_SETS
    BASIS_SET_FILE_NAME /home/ashiquel/software/cp2k/data/BASIS_MOLOPT
    POTENTIAL_FILE_NAME /home/ashiquel/software/cp2k/data/GTH_POTENTIALS
    BASIS_SET_FILE_NAME /home/ashiquel/software/cp2k/data/BASIS_MOLOPT_UZH
    BASIS_SET_FILE_NAME /home/ashiquel/software/cp2k/data/BASIS_MOLOPT_UCL
    CHARGE $SCHARGE
    LSD ${LSD}
    #MULTIPLICITY ${SMULTIPLICITY}



    &MGRID
      NGRIDS 5
      CUTOFF $CUTOFF
    &END
&PRINT

@IF ${PRINT_EDENSITY}==TRUE
  &E_DENSITY_CUBE
    &EACH
    GEO_OPT 10
    MD 100
    &END EACH
    STRIDE 1
    ADD_LAST SYMBOLIC
    LOG_PRINT_KEY .TRUE.
  &END E_DENSITY_CUBE
@ENDIF
@IF ${PRINT_VHARTREE}==TRUE
  &V_HARTREE_CUBE
    &EACH
    GEO_OPT 10
    MD 100
    &END EACH
    ADD_LAST SYMBOLIC
    # APPEND .TRUE.
    LOG_PRINT_KEY .TRUE.
  &END V_HARTREE_CUBE
@ENDIF
&KPOINTS OFF
&END KPOINTS
&END PRINT
    &QS
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 6
      METHOD GPW
    &END

    &SCF
    IGNORE_CONVERGENCE_FAILURE T
      SCF_GUESS ${SCF_GUESS}
      EPS_SCF 5.e-6
      MAX_SCF 50
      ADDED_MOS  80 
   &SMEAR  T
@IF ${SMULTIPLICITY}==2
    FIXED_MAGNETIC_MOMENT 1
@ENDIF
    METHOD  FERMI_DIRAC
    ELECTRONIC_TEMPERATURE     350
   &END SMEAR
   &MIXING  T
    METHOD  BROYDEN_MIXING
    ALPHA     0.4
    BETA    1.5
    N_SIMPLE_MIX 4
    NMIXING  5
    NBUFFER  8
   &END MIXING

&PRINT
&RESTART
&EACH
JUST_ENERGY 0
GEO_OPT 0
QS_SCF 0
MD 0
&END
BACKUP_COPIES 0
LOG_PRINT_KEY .TRUE.
ADD_LAST NUMERIC
&END
&END

&END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL PAIR_POTENTIAL
         &PAIR_POTENTIAL
            TYPE DFTD3
            PARAMETER_FILE_NAME /home/ashiquel/software/cp2k/data/dftd3.dat
            REFERENCE_FUNCTIONAL PBE
         &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
&XC_GRID
        ! defaults
        # XC_SMOOTH_RHO NONE
        # XC_DERIV PW
         XC_SMOOTH_RHO NN10
         XC_DERIV SPLINE2_SMOOTH
      &END XC_GRID
    &END XC
 &KPOINTS
   SCHEME  NONE
  &END KPOINTS
  &END DFT

  &SUBSYS
    &CELL
      ABC 14.46 14.46 40
      PERIODIC XYZ
    &END CELL
    &COLVAR
      &ANGLE
        ATOMS 418 419 420
      &END ANGLE
    &END COLVAR
&TOPOLOGY
COORD_FILE_FORMAT XYZ
COORD_FILE_NAME coord.xyz
      &CENTER_COORDINATES  T
      &END
&END TOPOLOGY


  &KIND Cu
   BASIS_SET DZV-GTH-PADE
   POTENTIAL GTH-PBE
  &END KIND

  &KIND Ag
   BASIS_SET DZV-GTH-PADE
   POTENTIAL GTH-PBE
  &END KIND

    &KIND H
      BASIS_SET TZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL GTH-PBE
      MASS 2
    &END

    &KIND O
      BASIS_SET TZVP-MOLOPT-PBE-GTH-q6
      POTENTIAL GTH-PBE
    &END KIND
  &KIND C
   BASIS_SET TZVP-MOLOPT-PBE-GTH-q4
   POTENTIAL GTH-PBE
  &END KIND
  &KIND Cs
   BASIS_SET TZVP-MOLOPT-PBE-GTH-q9
   POTENTIAL GTH-PBE
   MASS 20
  &END KIND


&END SUBSYS

  &PRINT
    &FORCES
    &END
 &END
&END FORCE_EVAL
