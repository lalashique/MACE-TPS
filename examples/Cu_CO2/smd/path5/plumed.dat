MOLINFO STRUCTURE=coord.pdb  PYTHON_BIN=python 

o12: GROUP ATOMS=420,422
o1: DISTANCE ATOMS=420,170
oh: DISTANCE ATOMS=163,170
h: GROUP ATOMS={@mda:{name H}}

#cooh: COMBINE ARG=o1,oh COEFFICIENTS=1,-1 PERIODIC=NO
cooh: COORDINATION GROUPA=o12 groupB=h R_0=1.3 NN=12 MM=24
co1: DISTANCE ATOMS=421,420
co2: DISTANCE ATOMS=421,422
co: CUSTOM ARG=co1,co2 FUNC=max(x,y) PERIODIC=NO

MOVINGRESTRAINT ...
   ARG=cooh
   STEP0=0 AT0=0.10 KAPPA0=10.0 
   STEP1=2000 AT1=1.0 KAPPA1=10.0
   STEP2=2500 KAPPA2=0
...

MOVINGRESTRAINT ...
   ARG=co
   STEP0=2000 AT0=1.4 KAPPA0=10.0 
   STEP1=4500 AT1=3.0 KAPPA1=10.0
   STEP2=5000  KAPPA2=0
...

PRINT ARG=o1,oh,cooh,co FILE=COLVAR

